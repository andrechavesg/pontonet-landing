    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <style>
        .carousel-control-prev-icon {
            background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' fill='%2305144D' viewBox='0 0 8 8'%3E%3Cpath d='M5.25 0l-4 4 4 4 1.5-1.5-2.5-2.5 2.5-2.5-1.5-1.5z'/%3E%3C/svg%3E") !important;
        }
        .carousel-control-next-icon {
            background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' fill='%2305144D' viewBox='0 0 8 8'%3E%3Cpath d='M2.75 0l-1.5 1.5 2.5 2.5-2.5 2.5 1.5 1.5 4-4-4-4z'/%3E%3C/svg%3E") !important;
        }
        .carousel-indicators [data-bs-target] {
            background-color: #05144D;
        }
        @media (max-width: 1024px) {
            .header-right { display: none; }
            #mainmenu .header-right { display: block; }
        }

        /* Social proof bar */
        .social-proof-bar {
            background: var(--bg-lighter, #fafafa);
            border-bottom: 1px solid var(--border-light, #e0e0e0);
            padding: 18px 0;
        }
        .social-proof-bar .proof-item {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-family: 'Work Sans', -apple-system, sans-serif;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-primary, #2c3e50);
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }
        .social-proof-bar .proof-item i {
            color: var(--color-success, #27ae60);
            font-size: 16px;
        }

        /* Feature groups */
        .feature-group {
            margin-bottom: 50px;
        }
        .feature-group-title {
            font-size: 22px;
            font-weight: 600;
            color: var(--color-secondary, #2c3e50);
            margin-bottom: 25px;
            padding-bottom: 10px;
            border-bottom: 3px solid var(--color-primary, #3498db);
            display: inline-block;
        }
        .feature-group-title i {
            margin-right: 10px;
            color: var(--color-primary, #3498db);
        }

        /* Feature comparison table */
        .comparison-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 40px;
            border-radius: var(--radius-lg, 14px);
            overflow: hidden;
        }
        .comparison-table th,
        .comparison-table td {
            padding: 14px 16px;
            text-align: center;
            border-bottom: 1px solid var(--border-light, #e0e0e0);
            font-size: 14px;
        }
        .comparison-table th {
            background: var(--color-secondary, #2c3e50);
            color: #fff;
            font-family: 'Poppins', -apple-system, sans-serif;
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .comparison-table th:first-child {
            text-align: left;
        }
        .comparison-table td:first-child {
            text-align: left;
            font-weight: 500;
            color: var(--text-primary, #2c3e50);
            font-family: 'Poppins', sans-serif;
        }
        .comparison-table tr:nth-child(even) {
            background: var(--bg-lighter, #fafafa);
        }
        .comparison-table tr:hover {
            background: rgba(52, 152, 219, 0.04);
        }
        .comparison-table .check {
            color: var(--color-success, #27ae60);
            font-size: 18px;
        }
        .comparison-table .cross {
            color: var(--color-gray-400, #ced4da);
            font-size: 18px;
        }

        /* Hero free badge */
        .free-badge {
            display: inline-block;
            background: var(--color-success, #27ae60);
            color: #fff;
            padding: 6px 18px;
            border-radius: var(--radius-pill, 9999px);
            font-family: 'Work Sans', -apple-system, sans-serif;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 15px;
        }

        /* Pricing free highlight */
        .pricing-box.free-plan {
            border: 2px solid var(--color-success, #27ae60);
            position: relative;
        }
        .pricing-box.free-plan::before {
            content: 'MAIS POPULAR';
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            background: var(--color-success, #27ae60);
            color: #fff;
            padding: 4px 20px;
            font-family: 'Work Sans', sans-serif;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            border-radius: 0 0 var(--radius-sm, 6px) var(--radius-sm, 6px);
        }

        /* CTA Banner */
        .cta-banner {
            background: linear-gradient(135deg, var(--color-secondary-dark, #1a252f) 0%, var(--color-secondary, #2c3e50) 100%);
            padding: 80px 0;
            text-align: center;
        }
        .cta-banner h2 {
            color: #fff;
            font-size: 36px;
            margin-bottom: 10px;
        }
        .cta-banner p {
            color: rgba(255, 255, 255, 0.7);
            font-size: 17px;
            margin-bottom: 30px;
        }
        .cta-banner .default-btn {
            background: var(--color-success, #27ae60);
            font-size: 15px;
            height: 52px;
            line-height: 52px;
            padding: 0 44px;
            border-radius: var(--radius-md, 10px);
        }
        .cta-banner .default-btn:hover {
            background: var(--color-success-dark, #229954);
            color: #fff;
        }

        /* Green CTA button */
        .btn-green {
            background: var(--color-success, #27ae60) !important;
            color: #fff !important;
        }
        .btn-green:hover {
            background: var(--color-success-dark, #229954) !important;
            color: #fff !important;
        }

        /* Pricing price green */
        .price-free {
            color: var(--color-success, #27ae60);
            font-size: 40px !important;
            font-weight: 700;
        }

        /* Secondary CTA */
        .btn-outline-light {
            border: 2px solid rgba(255, 255, 255, 0.4);
            color: rgba(255, 255, 255, 0.9);
            font-family: 'Work Sans', -apple-system, sans-serif;
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            height: 48px;
            line-height: 44px;
            padding: 0 32px;
            border-radius: var(--radius-md, 10px);
            display: inline-block;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            letter-spacing: 0.03em;
        }
        .btn-outline-light:hover {
            background: rgba(255, 255, 255, 0.15);
            border-color: rgba(255, 255, 255, 0.6);
            color: #fff;
        }
    </style>
    <script src="./js/modernizr-2.8.3-respond-1.4.2.min.js"></script>
