<!-- ===== ALL FEATURES (4 groups) ===== -->
<section id="funcionalidades" class="feature-section padding bd-bottom">
    <div class="anim-elements">
        <div class="anim-element"></div>
        <div class="anim-element"></div>
        <div class="anim-element"></div>
        <div class="anim-element"></div>
        <div class="anim-element"></div>
    </div>
    <div class="container">
        <div class="section-heading mb-40 text-center">
            <span>Tudo que voce precisa</span>
            <h2>Funcionalidades completas</h2>
            <p>Mais de 20 funcionalidades para gestao completa de ponto, equipes, compliance e relatorios.</p>
        </div>

        <!-- Group A: Registro de Ponto -->
        <div class="feature-group">
            <h3 class="feature-group-title"><i class="ti-time"></i> Registro de Ponto</h3>
            <div class="row">
                <div class="col-lg-4 col-sm-6 padding-15">
                    <div class="feature-content bg-blue">
                        <i class="ti-calendar color-blue"></i>
                        <h3>Calendario interativo</h3>
                        <p>Registre horas diretamente em uma interface de calendario intuitiva com visualizacao por dia, semana ou mes.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-sm-6 padding-15">
                    <div class="feature-content bg-purple">
                        <i class="fa fa-qrcode color-purple"></i>
                        <h3>QR Code</h3>
                        <p>Registre ponto escaneando um QR Code em qualquer dispositivo. Ideal para totens e pontos de entrada.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-sm-6 padding-15">
                    <div class="feature-content bg-red">
                        <i class="ti-timer color-red"></i>
                        <h3>Relogio / Cronometro</h3>
                        <p>Inicie e pare o cronometro para registrar horas de trabalho em tempo real com precisao.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-sm-6 padding-15">
                    <div class="feature-content bg-green">
